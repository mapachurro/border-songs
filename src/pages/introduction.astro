
---
import BaseLayout from "../layouts/BaseLayout.astro";
import Introduction, { frontmatter } from "../../binder/introduction.md";
import PhotoPageLayout from "../components/PhotoPageLayout.astro";

const background = frontmatter?.background ?? null;
---

<BaseLayout title="Introduction">
  <PhotoPageLayout background={background}>
  <article class="book-card book-card--introduction">
    <Introduction />
  </article>
</PhotoPageLayout>
</BaseLayout>
