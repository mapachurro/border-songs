---
import BaseLayout from "../layouts/BaseLayout.astro";
import Introduction from "../../binder/introduction.md";
import { siteUrl } from "../utils/siteUrl.js";

import { frontmatter } from "../../binder/introduction.md";

const backgroundUrl = frontmatter?.background
  ? siteUrl(frontmatter.background)
  : null;
---

<BaseLayout title="Introduction">
  <main
    class="introduction-page"
    style={backgroundUrl
      ? `--song-background: url("${backgroundUrl}")`
      : undefined}
  >
    <article class="introduction-card">
      <Introduction />
    </article>
  </main>
</BaseLayout>