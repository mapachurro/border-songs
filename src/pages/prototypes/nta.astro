---
import "../../nta.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>NTA layout prototype</title>
  </head>

  <body>
    <main class="nta-page">
      <header class="nta-header">
        <div class="nta-header-text">
          <strong>U.S. Department of Homeland Security</strong>
          <strong>Notice to Appear</strong>
        </div>
        <div class="nta-double-rule" aria-hidden="true">
          <div class="nta-rule-thick"></div>
          <div class="nta-rule-thin"></div>
        </div>
      </header>

      <section class="nta-content">
        <h1>
          In removal proceedings under section 240 of the Immigration and
          Nationality Act:
        </h1>

        <div class="nta-identifiers">
          <span>Subject ID:</span>
          <span>A#:</span>
          <span>DOB:</span>
        </div>

        <p>In the matter of:</p>
      </section>
    </main>
  </body>
</html>
