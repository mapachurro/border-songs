
---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoPageLayout from "../components/PhotoPageLayout.astro";
import TitlePage from "../../binder/title-page.md";

const titleFiles = import.meta.glob("../../binder/title-page.md", {
  eager: true,
  query: "?raw",
  import: "default",
});

const titleSource = Object.values(titleFiles)[0] as string;
const background = titleSource.match(/^background:\s*["']?([^"'\r\n]+)["']?/m)?.[1];
---

<BaseLayout title="Border Songs - Title Page">
  <PhotoPageLayout background={background}>
    <article class="book-card book-card--title">
      <TitlePage />
    </article>
  </PhotoPageLayout>
</BaseLayout>
