---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = (await getCollection('sections'))
  .sort((a, b) => a.data.order - b.data.order);

const songs = await getCollection('songs');

function songsForSection(sectionId: string) {
  return songs
    .filter((song) => song.id.startsWith(`${sectionId}/`))
    .sort((a, b) => a.id.localeCompare(b.id));
}

function trackNumber(songId: string) {
  const filename = songId.split('/').pop();
  return filename?.match(/^(\d+)/)?.[1] ?? '';
}
---

<BaseLayout title="Table of Contents">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="card mx-auto" style="max-width: 800px;">
        <div class="card-body">
          <h1 class="text-center mb-4">Table of Contents</h1>

          {sections.map((section) => {
            const sectionId = section.id.split('/')[0];
            const sectionSongs = songsForSection(sectionId);

            return (
              <details>
                <summary>
                  <strong>
                    <a href={`/${sectionId}/`}>
                      {section.data.title}
                    </a>
                  </strong>
                </summary>

                <div class="mt-3">
                  {sectionSongs.map((song) => (
                    <p>
                      <a href={`/${song.id}/`}>
                        {trackNumber(song.id)} - {song.data.title}
                      </a>

                      {song.data.authority && (
                        <> - {song.data.authority}</>
                      )}
                    </p>
                  ))}
                </div>
              </details>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>