---
import { getCollection } from "astro:content";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import Concordance from "../../components/Concordance.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parseSong } from "../../utils/parseSong.js";
import { renderMarkdown } from "../../utils/renderMarkdown.js";
import { siteUrl } from "../../utils/siteUrl.js";
import { parseTextSections } from "../../utils/parseTextSections.js";

export async function getStaticPaths() {
  const songs = await getCollection("songs");

  return songs.map((song) => {
    const [section, songSlug] = song.id.split("/");

    return {
      params: {
        section,
        song: songSlug,
      },
      props: {
        song,
      },
    };
  });
}

const { song } = Astro.props;
const { source, target, remainder } = parseSong(song.body ?? "");

const hasTranslation = target.length > 0;
const pairs = await Promise.all(
  source.map(async (sourceStanza: string, index: number) => ({
    source: await renderMarkdown(sourceStanza),
    target: hasTranslation ? await renderMarkdown(target[index]) : null,
  })),
);

const textSections = await Promise.all(
  parseTextSections(remainder).map(async (section) => ({
    ...section,
    html: await renderMarkdown(section.body),
  })),
);
const sectionId = song.id.split("/")[0];

const backgroundUrl = song.data.background
  ? siteUrl(song.data.background)
  : null;
---

<BaseLayout
  title={song.data.title ?? "Border Songs"}
  currentSection={sectionId}
  currentTitle={song.data.title}
>
  <div
    class="song-page"
    style={
      backgroundUrl ? `--song-background: url("${backgroundUrl}")` : undefined
    }
  >
    <div class="container py-5">
      <div class="card mx-auto" style="max-width: 800px;">
        <div class="card-body">
          {song.data.title && <h1>{song.data.title}</h1>}

          {song.data.authority && (
            <p>
              <strong>{song.data.authority}</strong>
            </p>
          )}

          {song.data.videoSource && (
            <YouTubeEmbed
              url={song.data.videoSource}
              title={`${song.data.title} video`}
            />
          )}
          <Concordance pairs={pairs} />

          <div class="song-sections">
  {
    textSections.map((section) => (
      <section
        class={`text-section text-section--${section.type}`}
        aria-label={section.title}
      >
        <div class="text-section__label">{section.title}</div>
        <div class="text-section__body" set:html={section.html} />
      </section>
    ))
  }
</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
