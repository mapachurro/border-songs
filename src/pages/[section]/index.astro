---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrackList from "../../components/TrackList.astro";

export async function getStaticPaths() {
  const sections = await getCollection("sections");

  return sections.map((section) => {
    const [sectionSlug] = section.id.split("/");

    return {
      params: {
        section: sectionSlug,
      },
      props: {
        section,
      },
    };
  });
}

const { section } = Astro.props;
const { Content } = await render(section);
const sectionSlug = section.id.split("/")[0];

const songs = await getCollection("songs");

const sectionSongs = songs
  .filter((song) => song.id.startsWith(`${sectionSlug}/`))
  .sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
  title={section.data.title}
  currentSection={sectionSlug}
>
  <div class="container py-5">
    <div class="card mx-auto" style="max-width: 800px;">
      <div class="card-body">
        <h1>{section.data.title}</h1>

        <TrackList songs={sectionSongs} />

        <Content />
      </div>
    </div>
  </div>
</BaseLayout>