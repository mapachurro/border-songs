---
interface StanzaPair {
  source: string;
  target: string | null;
}

interface Props {
  pairs: StanzaPair[];
  sourceTitle?: string;
  targetTitle?: string;
}

const {
  pairs,
  sourceTitle = "Source",
  targetTitle = "Target",
} = Astro.props;
---

<section class="concordance">
  <div class="concordance-header" aria-hidden="true">
  <div>{sourceTitle}</div>
  <div>{targetTitle}</div>
</div>

  {pairs.map((pair) => (
    <div class="concordance-pair">
      <div class="concordance-source" set:html={pair.source} />

      {pair.target !== null && (
        <div class="concordance-target" set:html={pair.target} />
      )}
    </div>
  ))}
</section>
