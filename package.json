{
  "name": "border-songs",
  "version": "0.5.3",
  "description": "Static frontend generator for mapachurro's Border Songs project.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "deploy": "npm run build && gh-pages -d dist",
    "print:image": "docker build -t border-songs-latex -f docker/latex/Dockerfile .",
    "build:print": "mkdir -p dist-print && docker run --rm -v \"$PWD:/work\" border-songs-latex --output-directory=dist-print latex/prototypes/nta.tex",
    "build:all": "npm run build && npm run build:print"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapachurro/border-songs.git"
  },
  "keywords": [
    "translation",
    "i18n",
    "l10n",
    "poetry",
    "baladas",
    "frontera",
    "western"
  ],
  "author": "mapachurro",
  "license": "SEE LICENSE IN ./licenses",
  "bugs": {
    "url": "https://github.com/mapachurro/border-songs/issues"
  },
  "homepage": "https://mapachurro.github.io/border-songs/",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.3",
    "doctoc": "^2.2.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
